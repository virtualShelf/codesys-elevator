(* ==========================================================================
   E_ElevState : エレベータの状態
   値は Modbus の IR0 にそのまま載り、画面（web/src/config.ts）と対応しているので、
   番号を変えないこと
   ========================================================================== *)
{attribute 'qualified_only'}   (* CODESYS 独自: E_ElevState.Idle の形でしか書けないようにする *)
TYPE E_ElevState :
(
    Idle        := 0,   (* 扉を閉めて停止中 *)
    DoorOpening := 1,   (* 扉を開けている途中 *)
    DoorOpen    := 2,   (* 扉が開いている（乗り降り中） *)
    DoorClosing := 3,   (* 扉を閉めている途中 *)
    Moving      := 4,   (* 移動中 *)
    Overload    := 5    (* 重量・人数オーバー。扉を開けたまま警報 *)
) INT;
END_TYPE
