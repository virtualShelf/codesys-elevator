(* ==========================================================================
   E_ElevCmd : 画面から送られてくる指令の種類（Modbus の HR0 の値）
   ========================================================================== *)
{attribute 'qualified_only'}   (* CODESYS 独自: E_ElevCmd.CarCall の形でしか書けないようにする *)
TYPE E_ElevCmd :
(
    None      := 0,
    CarCall   := 1,   (* かご内の行き先ボタン（対象階 = HR1） *)
    HallCall  := 2,   (* 乗り場の呼びボタン（対象階 = HR1） *)
    DoorOpen  := 3,   (* 「開」ボタン *)
    DoorClose := 4    (* 「閉」ボタン *)
) INT;
END_TYPE
